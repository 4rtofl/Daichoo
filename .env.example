# 手元で使う値。このファイルを .env にコピーして値を入れる(.env はGitに入れない)。
# pnpm register-commands と pnpm dev(wrangler dev)が読み込む。
# 初めてデプロイするときは「pnpm exec wrangler deploy --secrets-file .env」を実行する。.env の値が、すべてWorkerのシークレットになる。
# あとで値を変えるときは「pnpm exec wrangler secret put <名前>」を使う。
# 準備の手順: README.md「準備」

# Developer Portal > General Information の Application ID(コマンドの登録に使う)
DISCORD_APPLICATION_ID=
# Developer Portal > General Information の Public Key(Interactionの署名の確認に使う)
DISCORD_PUBLIC_KEY=
# Developer Portal > Bot で発行したトークン
DISCORD_BOT_TOKEN=
# GitHub Appの秘密鍵(台帳にコミットするのに使う)。ダウンロードした .pem ファイルの中身を、
# 改行もそのままにして、全体をダブルクォートで囲んで入れる。例:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# MIIE...
# -----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY=
