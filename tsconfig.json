{
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		// Workerのコードも、Web標準のAPI(fetch、Request、crypto.subtleなど)しか使わないので、
		// Node.jsの型定義だけで型を確かめる。Worker固有の型は src/env.ts に自分で書く
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		// 精算のスクリプトは、ビルドせずに「node scripts/settle.ts」で動かす。
		// Node.jsは型を取り除くだけなので、enumのような、取り除くだけでは動かない書き方を禁じる
		"erasableSyntaxOnly": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"src/**/*.ts",
		"scripts/**/*.ts",
		"test/**/*.ts",
		"vitest.config.ts"
	]
}
