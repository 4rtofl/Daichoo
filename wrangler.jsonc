{
	"$schema": "node_modules/wrangler/config-schema.json",
	// DiscordのInteractionsを受け付けるWorker。構成: README.md「構成」
	"name": "daichoo",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"observability": {
		"enabled": true
	},
	"vars": {
		// Botを使うDiscordサーバーのID。ほかのサーバーからのコマンドは受け付けない。
		// pnpm register-commands も、このサーバーにコマンドを登録する
		"DISCORD_GUILD_ID": "",
		// 台帳を置くGitHubのリポジトリ(所有者/リポジトリ名)と、書き込むブランチ
		"GITHUB_REPOSITORY": "4rtoflow/Daichoo",
		"GITHUB_BRANCH": "main"
	},
	// 手元では .env、Cloudflare上では「pnpm exec wrangler secret put <名前>」で設定する(.env.example を参照)
	"secrets": {
		"required": ["DISCORD_PUBLIC_KEY", "DISCORD_BOT_TOKEN", "GITHUB_TOKEN"]
	}
}
